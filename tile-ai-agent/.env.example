# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。
# 密钥只走环境变量,不落代码、不落库(架构 §13.6)。

SERVICE_NAME=tile-ai-agent
PORT=8000

# Java 业务核
JAVA_BASE_URL=http://localhost:8080
SERVICE_TOKEN=

# ----------------------------------------------------------------------
# 模型网关(架构 §7.2;选型见 §15.1)
# ----------------------------------------------------------------------
# provider 取值见 app/gateway/factory.py 的预置表;留空 = 未配置。
# base_url / model 留空时用该 provider 的预置值。

# LLM 主力:DeepSeek(架构 §15.1)
# ⚠️ 模型 ID 必须是 `deepseek-flash`。`deepseek-v4-flash` 已于 2026-09-10 退役,
#    `deepseek-chat` / `deepseek-reasoner` 已于 2026-07-24 停用 —— 照抄旧教程会 404。
MODEL_LLM_PROVIDER=deepseek
MODEL_LLM_API_KEY=
MODEL_LLM_BASE_URL=
MODEL_LLM_MODEL=

# LLM 备份:智谱 GLM(故障域与主力独立,§15.1;失败率 > 10% 时切换,§13.7)
# ⚠️ 待办:GLM 的具体模型 ID 文档未定,须先核对官方文档再填 —— 这里**不猜**。
MODEL_LLM_BACKUP_PROVIDER=zhipu
MODEL_LLM_BACKUP_API_KEY=
MODEL_LLM_BACKUP_BASE_URL=
MODEL_LLM_BACKUP_MODEL=

# 图像:通义万相(架构 §15.1 已选 wan2.7-image-pro)
# ⚠️ 该模型的请求/响应形态**尚未与百炼官方文档核实**,首次联调前必须确认。
#
# 或填 `placeholder` —— 替身网关,返回 Java 侧那张固定占位图
# (tile-ai-server/src/main/resources/static/placeholder.svg)。它是**当前阶段
# (§29,2026-09-30)的默认选择**:本期只要端到端跑通「看到图」,不评出图质量。
# 切回真模型只需把这一行改回 dashscope,别处不用动(§29.5)。
MODEL_IMAGE_PROVIDER=dashscope
MODEL_IMAGE_API_KEY=
MODEL_IMAGE_BASE_URL=
MODEL_IMAGE_MODEL=

# Embedding:模型未定(P0-2 残留)。留空 = 用确定性占位实现,索引链路照常可跑。
MODEL_EMBEDDING_PROVIDER=
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_BASE_URL=
MODEL_EMBEDDING_MODEL=

# 成本计量单价表(JSON)。单价只从配置来,不硬编码 —— 厂商调价是常态。
# 单位:元 / 百万 token,元 / 张。
GATEWAY_MODEL_PRICES={"deepseek": {"input_per_million": 1, "output_per_million": 2}, "dashscope": {"per_image": 0.2}}

# ----------------------------------------------------------------------
# 韧性(架构 §7.2)
# ----------------------------------------------------------------------
# 图像单图 ≤60s 是硬指标(§7.3 / §13.1),不要放宽。
GATEWAY_LLM_TIMEOUT_SECONDS=30
GATEWAY_IMAGE_TIMEOUT_SECONDS=60
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_BACKOFF_BASE_SECONDS=0.5
GATEWAY_BACKOFF_MAX_SECONDS=8

# 限流:架构 §13.2 指定 Redis 令牌桶
GATEWAY_RATE_LIMIT_RPS=5
GATEWAY_RATE_LIMIT_BURST=10
REDIS_URL=redis://localhost:6379/0

GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_RECOVERY_SECONDS=30

# 故障切换:§13.7 的 10% 阈值
GATEWAY_FAILOVER_FAILURE_RATE=0.10
# 样本不足此数时不下判定,避免首次调用失败就把主力切走
GATEWAY_FAILOVER_MIN_SAMPLES=5
GATEWAY_FAILOVER_WINDOW=20
GATEWAY_FAILOVER_PROBE_SECONDS=60

# ----------------------------------------------------------------------
# 生成编排(T-1.11;架构 §6.2、§11.2)
# ----------------------------------------------------------------------
# Python → Java 取数(/internal/products、/internal/furnish)的超时。
# 一次索引查询,几秒不回就是出问题了。
JAVA_API_TIMEOUT_SECONDS=5
# 回传的超时。Java 要写任务状态、终局还要顺带保存方案(一次事务),给更宽的余量。
# ⚠️ 两者都与 GATEWAY_IMAGE_TIMEOUT_SECONDS(60s)无关 —— 那是**模型**调用的硬指标。
JAVA_CALLBACK_TIMEOUT_SECONDS=10

# 生成消费端是否随本进程启动。本地联调要开。
GENERATE_CONSUMER_IN_PROCESS=true
# 替身图的 URL 前缀。留空 = 用 JAVA_BASE_URL —— 图必须由 Java 提供:
# 前端只连 Java(不变量 3),挂在 Python 上本地能跑通、上线会被网关拦掉。
PLACEHOLDER_IMAGE_BASE_URL=
