<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.tileai</groupId>
  <artifactId>tile-ai-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>tile-ai-server</name>
  <description>瓷砖选购 AI — Java 业务核(唯一对外 API)</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Boot 的依赖管理不含 MyBatis-Plus 与 jjwt,需自行钉版本 -->
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <jjwt.version>0.12.6</jjwt.version>
    <poi.version>5.5.1</poi.version>
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 鉴权(T-0.4)与缓存(T-0.4 refresh_token 黑名单) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- AOP:操作日志切面(T-0.5,写操作记入 t_operation_log) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- 批量导入的 Excel 模板与解析(T-0.7;契约模板接口同时声明 xlsx 与 CSV 两种类型) -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- RabbitMQ(P0-3① 裁决一期采用;T-0.13 的向量索引同步经 queue.index.sync 投递) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 持久化栈 —— T-0.2 引入(架构 §3:MyBatis-Plus / MySQL 8 / Flyway 版本化迁移) -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- T-0.9:用契约里的 LayoutModel JSON Schema 校验落库的户型结构(仅测试使用) -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        ====================================================================
        测试数据库隔离(2026-10-07)

        背景:集成测试原先连的是**用户正在用的演示库 tile_ai**,而其中若干
        测试做无条件全表删除(删 t_store / t_quote_param 的关键行)。
        2026-10-07 跑了一次全量测试,把用户的真实数据删掉了。

        本配置把**测试子进程**钉到独立的测试库 tile_ai_test,并改用
        **只有 tile_ai_test 权限**的受限账号 —— 三重保险:
          ① 数据库授权:tile_test 连 tile_ai 就是 ERROR 1142,代码写错也删不动;
          ② 本配置:进程根本看不到用户库的地址;
          ③ 测试内护栏:万一前两层都失效,测试会在连库前当场失败。

        ⚠️ **为什么要钉 6 个变量**:Spring 的属性优先级里 **OS 环境变量高于
        application.yml 的占位符** —— 只钉 DB_URL 的话,开发者 shell 里若存在
        SPRING_DATASOURCE_URL,它会直接压过去,隔离**静默失效**。

        ⚠️ 这里的口令是本机测试专用账号,权限**仅限 tile_ai_test**,泄了也
        动不了业务数据 —— 这是它和"生产口令不落代码"(架构 §12.3)不冲突的原因。

        ⚠️ forkCount 必须 >= 1:forkCount=0 时 environmentVariables 不生效。
        测试内的护栏(见 DbIsolationGuardInitializer)是这条的兜底。
        ====================================================================
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <environmentVariables>
            <DB_URL>jdbc:mysql://localhost:3306/tile_ai_test?useUnicode=true&amp;characterEncoding=utf8&amp;serverTimezone=Asia/Shanghai&amp;allowPublicKeyRetrieval=true&amp;useSSL=false</DB_URL>
            <DB_USERNAME>tile_test</DB_USERNAME>
            <DB_PASSWORD>tile_test_pw</DB_PASSWORD>
            <SPRING_DATASOURCE_URL>jdbc:mysql://localhost:3306/tile_ai_test?useUnicode=true&amp;characterEncoding=utf8&amp;serverTimezone=Asia/Shanghai&amp;allowPublicKeyRetrieval=true&amp;useSSL=false</SPRING_DATASOURCE_URL>
            <SPRING_DATASOURCE_USERNAME>tile_test</SPRING_DATASOURCE_USERNAME>
            <SPRING_DATASOURCE_PASSWORD>tile_test_pw</SPRING_DATASOURCE_PASSWORD>
            <!-- Redis 同样在共享:RedisTokenStoreTest 会 delete("auth:*"),
                 而 auth: 是线上会话/刷新令牌黑名单的前缀 —— 跑一次就把用户
                 正在用的登录态抹掉。第 15 库专供测试。 -->
            <SPRING_DATA_REDIS_DATABASE>15</SPRING_DATA_REDIS_DATABASE>
            <!-- RabbitMQ 同理:测试与运行中的应用共用 broker 时,两边会互相
                 抢消息 —— 2026-10-07 实测:queue.index.sync 里积压 51 条旧消息
                 后,IndexSyncIntegrationTest 会偶发空指针(单独跑 6/6 通过)。
                 测试专用 vhost,拓扑由应用启动时自行声明。 -->
            <SPRING_RABBITMQ_VIRTUAL_HOST>tileai_test</SPRING_RABBITMQ_VIRTUAL_HOST>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
